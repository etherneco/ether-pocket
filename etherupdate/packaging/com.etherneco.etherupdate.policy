<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
 <vendor>Etherneco LTD</vendor>
 <action id="com.etherneco.etherupdate.credentials">
  <description>Save or remove the AutoUpdate access token</description>
  <message>Authenticate to change the protected AutoUpdate credential</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
 </action>
 <action id="com.etherneco.etherupdate.manage">
  <description>Check, download and configure EtherPocket updates</description>
  <message>Authenticate to manage software updates</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
 </action>
 <action id="com.etherneco.etherupdate.install">
  <description>Install a reviewed and verified update</description>
  <message>Authenticate to install this update after reviewing its recovery plan</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
 </action>
</policyconfig>
