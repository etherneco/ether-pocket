#%PAM-1.0
# Separate stack: never rewrite common-auth or weaken account restrictions.
auth required pam_faildelay.so delay=2000000
auth requisite pam_faillock.so preauth silent deny=5 fail_interval=900 unlock_time=120
auth [success=1 default=bad] pam_unix.so
auth [default=die] pam_faillock.so authfail deny=5 fail_interval=900 unlock_time=120
auth required pam_faillock.so authsucc deny=5 fail_interval=900 unlock_time=120
@include common-account
