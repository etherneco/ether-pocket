[Unit]
Description=EtherShare internet sharing controller
After=NetworkManager.service dbus.service
Wants=NetworkManager.service

[Service]
Type=dbus
BusName=com.etherneco.EtherShare1
ExecStart=/usr/bin/python3 /usr/libexec/ethershare/service.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
StateDirectory=ethershare
RuntimeDirectory=ethershare
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ethershare /run/ethershare /run/xtables.lock /proc/sys/net/ipv4/ip_forward
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
