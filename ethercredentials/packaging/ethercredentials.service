[Unit]
Description=EtherCredentials privileged verifier
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/share/ethercredentials/launcher.py
User=root
UMask=0077
RuntimeDirectory=ethercredentials
RuntimeDirectoryMode=0755
StateDirectory=ethercredentials
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LimitCORE=0
ReadWritePaths=/var/lib/ethercredentials /run/ethercredentials -/run/faillock

[Install]
WantedBy=multi-user.target
