#!/bin/busybox sh
# First native kernel test. Never mount internal phone block devices.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev; then
    # The known recovery kernel has no DEVTMPFS support.
    mount -t tmpfs tmpfs /dev
    mknod /dev/console c 5 1
    mknod /dev/null c 1 3
    mknod /dev/zero c 1 5
    mknod /dev/random c 1 8
    mknod /dev/urandom c 1 9
    mknod /dev/tty c 5 0
    /bin/busybox mdev -s
fi
mkdir -p /run /dev/pts /dev/shm
mount -t tmpfs tmpfs /run
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
echo EtherPocket-native-kernel-test > /proc/sys/kernel/hostname
echo 'EtherPocket native Linux RAM bootstrap' > /dev/console
/usr/local/sbin/etherpocket-usb-debug > /run/usb-debug.log 2>&1 &
usb_pid=$!
/usr/sbin/dropbear -F -E -s -r /etc/dropbear/dropbear_ed25519_host_key > /run/ssh.log 2>&1 &
ssh_pid=$!
switch_to_mobian() {
    if [ ! -f /newroot/etc/etherpocket/rootfs-ready ] || [ ! -x /newroot/init ]; then
        echo 'Mobian RAM root is not verified and ready.' > /dev/console
        return
    fi
    kill "$ssh_pid" "$usb_pid" 2>/dev/null
    mount --move /dev /newroot/dev
    mount --move /sys /newroot/sys
    mount --move /proc /newroot/proc
    mount --move /run /newroot/run
    exec /bin/busybox switch_root /newroot /init
}
trap switch_to_mobian USR1
while :; do sleep 2; done
