[Unit]
Description=EtherSensors native sensor framework
After=dbus.service
[Service]
Type=dbus
BusName=com.etherneco.EtherSensors1
ExecStart=/usr/bin/python3 /usr/share/ethersensors/service.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=yes
TimeoutStopSec=5
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
